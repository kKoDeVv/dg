_satellite.__registerScript('https://assets.adobedtm.com/b359cfb740b4/a792d4e6ffcd/de03df24099a/RC7ea580e608e54837b6e1fb9cf9d93d2b-source.min.js', "<!--Text bubble-->\n<div id=\"sf-chat-text-bubble\" class=\"chat-text-bubble\">\n    Need help? Chat with us!\n</div>\n\n<!--placing the text Bubble near chat button-->\n<style>\n.chat-text-bubble {\n  position: fixed;\n  font-weight: 500;\n  bottom: 65px; /* ~above default chat button */\n  right: 80px;  /* adjust if needed */\n  background-color: #ffffff;\n  color: #333333;\n  border-radius: 20px;\n  padding: 10px 14px;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);\n  font-size: 14px;\n  max-width: 220px;\n  z-index: 9999;\n  animation: fadeInUp 0.6s ease-out;\n}\n\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20%);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n</style>\n<script type='text/javascript'>\n\nfunction initEmbeddedMessaging() {\n\ntry {\n\nembeddedservice_bootstrap.settings.language = 'en_US'; // For example, enter 'en' or 'en-US'\n\nembeddedservice_bootstrap.init(\n\n'00D3000000001lK',\n\n'Fortinet_AgentForce',\n\n'https://fortinet.my.site.com/ESWFortinetAgentForce1746577951287',\n\n{\n\nscrt2URL: 'https://fortinet.my.salesforce-scrt.com'\n\n}\n\n);\n\n} catch (err) {\n\nconsole.error('Error loading Embedded Messaging: ', err);\n\n}\n\n};\n\n</script>\n\n<script type='text/javascript' src='https://fortinet.my.site.com/ESWFortinetAgentForce1746577951287/assets/js/bootstrap.min.js' onload='initEmbeddedMessaging()'></script>\n\n<script>\n      \n\tfunction hideTextBlurb() {\n\t  const bubble = document.getElementById('sf-chat-text-bubble');\n\t  if (bubble) bubble.style.display = 'none';\n\t}\n\n\tfunction observeIsMaximizedClass(iframe) {\n\t  let wasMaximized = iframe.classList.contains('isMaximized');\n\n\t  const observer = new MutationObserver((mutations) => {\n\t\tmutations.forEach((mutation) => {\n\t\t  if (mutation.type === 'attributes' && mutation.attributeName === 'class') {\n\t\t\tconst isNowMaximized = iframe.classList.contains('isMaximized');\n\n\t\t\tif (!wasMaximized && isNowMaximized) {\n\t\t\t  // isMaximized class was just added\n\t\t\t  hideTextBlurb();\n\t\t\t}\n\n\t\t\twasMaximized = isNowMaximized;\n\t\t  }\n\t\t});\n\t  });\n\n\t  observer.observe(iframe, { attributes: true, attributeFilter: ['class'] });\n\t}\n\n\t// Keep checking every 300ms for the iframe to appear\n\tconst waitForIframe = setInterval(() => {\n\t  const iframe = document.querySelector('iframe.embeddedMessagingFrame');\n\n\t  if (iframe) {\n\t\tclearInterval(waitForIframe);\n\t\tobserveIsMaximizedClass(iframe);\n\t  }\n\t}, 300);\n\n</script>");