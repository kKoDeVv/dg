_satellite.__registerScript('https://assets.adobedtm.com/b359cfb740b4/a792d4e6ffcd/de03df24099a/RCc3646018a6b1451aaeb0b627a2ef9da1-source.min.js', "<!--script src=\"https://apps.global.fortinet.com/e/er?s=3049749&lid=302\"></script!-->\n\n<script src=\"https://apps.global.fortinet.com/e/er?s=3049749&lid=3139&elq=~~eloqua..type--emailfield..syntax--recipientid..encodeFor--url~~&elqak=8AF593FBC81249E6B639B68A109B6E9B33290962A00EA0563AA980E0885802DAC974\"></script>\n<!--script src=\"https://www.fortinet.com/etc/designs/fortinet/clientlib-components/Form-Autofill.min.js\"></script!-->\n\n<script>\n  \n      $(document).ready(function() {\n        setTimeout(function(){\n               $('.ftnt-subscribe-form #email').val('')\n          }, 3000);\n\n\n        // Array of field names or IDs to hide if they are non-empty\n      const hideFields = [\"firstName\",\"lastName\",\"jobFunction\", \"jobLevel\", \"company\", \"BusPhone\", \"zipPostal\"]; // Add the names or IDs of elements to hide\n\n      // Function to selectively hide parent div of non-empty form elements from the specified list\n      function hideNonEmptyParentDivs(form) {\n        const elements = form.querySelectorAll(\"input, select, textarea\");\n\n        $.each(elements, function(index, element) {\n          // Get the name or ID of the element\n          const fieldName = element.getAttribute(\"name\") || element.getAttribute(\"id\");\n\n          // Check if the field should be hidden based on the hideFields list and if it's non-empty\n          if (hideFields.includes(fieldName) && element.value) {\n            // Find the parent div with class 'text' or 'dropdown'\n            const parentDiv = element.closest(\".text, .dropdown\");\n\n            const stateElement = form.querySelectorAll(\"select[name='stateProv']\")[0];\n\n           /* if (fieldName == \"country\"){\n              stateElement.closest(\".text, .dropdown\").style.display = \"none\";\n            } */\n\n            // Hide the parent div if found\n            if (parentDiv) {\n              parentDiv.style.display = \"none\";\n            }\n          }\n        });\n      }\n\n\n        function handleFilledInput(inputField) {\n            if (inputField.val()) {\n                // Add a class or trigger an event when the input is filled\n                inputField.addClass('populated');\n                inputField.next('span').hide();\n\n            } else {\n                // Remove the class or trigger an event when the input is empty\n                inputField.removeClass('populated');\n                inputField.next('span').show();\n\n            }\n        }\n\n        // Function to selectively show parent div of empty form elements from the specified list\n      function showEmptyParentDivs(form) {\n        const elements = form.querySelectorAll(\"input, select, textarea\");\n\n        $.each(elements, function(index, element) {\n          // Get the name or ID of the element\n          const fieldName = element.getAttribute(\"name\") || element.getAttribute(\"id\");\n\n          // Check if the field should be hidden based on the hideFields list\n          if (hideFields.includes(fieldName)) {\n            // Find the parent div with class 'text' or 'dropdown'\n            const parentDiv = element.closest(\".text, .dropdown\");\n\n            // Show the parent div if found\n            if (parentDiv) {\n              $(parentDiv).show();\n              $('.contact--form .populated+span').show();\n            }\n\n            $('input[type=\"text\"]').on('input', function() {\n                      handleFilledInput($(this));\n                  });\n            $('input[type=\"email\"]').on('input', function() {\n                      handleFilledInput($(this));\n                  });\n            $('select').on('change', function() {\n                      handleFilledInput($(this));\n                  });\n          }\n        });\n      }\n\n\n      // Run the function after 7 seconds\n         setTimeout(function(){\n          const form = document.querySelector(\"form.eloquaGated\");\n           if(null !== form && _elqforms.wdls.known){\n            hideNonEmptyParentDivs(form);\n            $(\"#notyouclick\").on(\"click\", function(event) {\n              showEmptyParentDivs(form);\n            });\n             $('input[type=\"reset\"]').on(\"click\", function(event) {\n              showEmptyParentDivs(form);\n            });\n           }\n           \n        }, 2000); // 2000 milliseconds = 4 seconds\n\n      });\n  \n</script>");