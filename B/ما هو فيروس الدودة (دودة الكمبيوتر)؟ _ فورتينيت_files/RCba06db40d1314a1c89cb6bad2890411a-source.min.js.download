// For license information, see `https://assets.adobedtm.com/b359cfb740b4/a792d4e6ffcd/de03df24099a/RCba06db40d1314a1c89cb6bad2890411a-source.js`.
_satellite.__registerScript('https://assets.adobedtm.com/b359cfb740b4/a792d4e6ffcd/de03df24099a/RCba06db40d1314a1c89cb6bad2890411a-source.min.js', "<script>\nvar\n  cookieScriptWindow = window.document,\n  cookieScripts = document.getElementsByTagName(\"script\"),\n  cookieScriptDomain = \".fortinet.com\",\n  cookieScriptDebug = 0,\n  cookieScriptShowBadge = true,\n  cookieScriptCurrentUrl = window.location.href,\n  pagePath = window.location.pathname,\n  ftntCampaign = \"ftnt_campaign\";\n\n\nftntInjectCookieScript = function () \n{\n\n  ftntCookieScriptCreateCookie = function (n, t, i) {\n\n\n          if (window.location.protocol == \"https:\")\n              var cookieScriptSecureCookie = \";secure\";\n          else\n              var cookieScriptSecureCookie = \"\";\n          var u = \"\",\n            r, f;\n          i && (r = new Date, r.setTime(r.getTime() + i * 864e5), u = \"; expires=\" + r.toGMTString()), f = \"\", cookieScriptDomain != \"\" && (f = \"; domain=\" + cookieScriptDomain), document.cookie = n + \"=\" + t + u + f + \"; path=/\" + cookieScriptSecureCookie;\n      },\n\n                    ftntCookieScriptReadCookie = function (n) {\n                        for (var r = n + \"=\", u = document.cookie.split(\";\"), t, i = 0; i < u.length; i++) {\n                            for (t = u[i]; t.charAt(0) == \" \";) t = t.substring(1, t.length);\n                            if (t.indexOf(r) == 0) return t.substring(r.length, t.length)\n                        }\n                        return null\n                    };\n};\n    ftntInjectCookieScript();           \n                \n     \n  \n   function updateCampaignCookie(){\n\n        var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];\n        var urlParams = new URLSearchParams(window.location.search);\n        var utmValues = keys.map(function(key) {\n                \t\t\t\t\t\t\t\tvar value = urlParams.get(key);\n                  \t\t\t\t\t\t\treturn value ? value : '';\n                \t\t\t\t\t\t\t}).join(',');\n        var form = document.querySelectorAll( ['form.eloquaBasic','form.eloquaGated'].join(','));\n        var elqform = document.querySelectorAll(['form.elq-form'].join(','));\n\n        if (_satellite.getVar('OTFunctionalCookiesActive') && (',,,,' != utmValues && (utmValues.match(/none/g) || []).length < keys.length)) {\n            // If we have at least one parameter, set cookie.\n            \n               \n             var readutmValues = ftntCookieScriptReadCookie(ftntCampaign);\n             var newUtmValues=\"\";\n                            if(null !== readutmValues && '' !== readutmValues && ',,,,' != readutmValues){\n                              var cookieCampaignsnew=readutmValues.split(\",\");\n                              try{\n\n                             newUtmValues+=urlParams.get(\"utm_source\")?urlParams.get(\"utm_source\"):cookieCampaignsnew[0]?cookieCampaignsnew[0]:'';\n                                newUtmValues+=',';\n                             newUtmValues+=urlParams.get(\"utm_medium\")?urlParams.get(\"utm_medium\"):cookieCampaignsnew[1]?cookieCampaignsnew[1]:'';\n                                newUtmValues+=',';\n                             newUtmValues+=urlParams.get(\"utm_campaign\")?urlParams.get(\"utm_campaign\"):cookieCampaignsnew[2]?cookieCampaignsnew[2]:'';\n                                newUtmValues+=',';\n                             newUtmValues+=urlParams.get(\"utm_term\")?urlParams.get(\"utm_term\"):cookieCampaignsnew[3]?cookieCampaignsnew[3]:''; \n                                newUtmValues+=',';\n                             newUtmValues+= urlParams.get(\"utm_content\")?urlParams.get(\"utm_content\"):cookieCampaignsnew[4]?cookieCampaignsnew[4]:''; \n                                           ftntCookieScriptCreateCookie(ftntCampaign, newUtmValues, 30);\n                               }catch(err){}\n                            }else{\n                                        ftntCookieScriptCreateCookie(ftntCampaign, utmValues, 30);\n\n                            }\n\n\n            \n          var newutmCookieValues= ftntCookieScriptReadCookie(ftntCampaign);\n          var  newcookieCampaigns=newutmCookieValues.split(\",\");\n          if(form.length > 0){\n                try{\n                 document.getElementById(\"utmsource\").value =newcookieCampaigns[0]?newcookieCampaigns[0]:'';\n                 document.getElementById(\"utmmedium\").value = newcookieCampaigns[1]?newcookieCampaigns[1]:'';\n                 document.getElementById(\"utmcampaign\").value =newcookieCampaigns[2]?newcookieCampaigns[2]:'';\n                 document.getElementById(\"utmterm\").value = newcookieCampaigns[3]?newcookieCampaigns[3]:'';\n                 if(!document.getElementById(\"utmcontent\").value.startsWith(\"ab-test-experiment\")){ //don't override for ab-test Adobe-target\n                   document.getElementById(\"utmcontent\").value =newcookieCampaigns[4]?newcookieCampaigns[4]:'';\n                }\n                }catch(errr1){}\n          }else if(elqform.length > 0){  //for Elq site             \n                  try{\n                   document.getElementsByName(\"utm_source\")[0].value = newcookieCampaigns[0]?newcookieCampaigns[0]:'';\n                   document.getElementsByName(\"utm_medium\")[0].value = newcookieCampaigns[1]?newcookieCampaigns[1]:'';\n                   document.getElementsByName(\"utm_campaign\")[0].value = newcookieCampaigns[2]?newcookieCampaigns[2]:'';\n                   document.getElementsByName(\"utm_term\")[0].value = newcookieCampaigns[3]?newcookieCampaigns[3]:'';\n                   document.getElementsByName(\"utm_content\")[0].value = newcookieCampaigns[4]?newcookieCampaigns[4]:'';\n                }catch(errr2){}\n          }\n        } else if(_satellite.getVar('OTFunctionalCookiesActive')){\n                utmValues = ftntCookieScriptReadCookie(ftntCampaign);\n                if(null !== utmValues && '' !== utmValues && ',,,,' !== utmValues){\n                  var cookieCampaigns=utmValues.split(\",\");   \n                  var cookieElqCampaigns=utmValues.split(\",\");\n                  \n                 if(form.length > 0){\n                  try{\n                   document.getElementById(\"utmsource\").value = cookieCampaigns[0];\n                   document.getElementById(\"utmmedium\").value = cookieCampaigns[1];\n                   document.getElementById(\"utmcampaign\").value = cookieCampaigns[2];\n                   document.getElementById(\"utmterm\").value = cookieCampaigns[3];\n                    if(!document.getElementById(\"utmcontent\").value.startsWith(\"ab-test-experiment\")){ //don't override for ab-test Adobe-target\n                     document.getElementById(\"utmcontent\").value = cookieCampaigns[4];    \n                    }\n                   }catch(err1){}\n\n                 }else if(elqform.length > 0){  //for Elq site                 \n                      try{\n                     document.getElementsByName(\"utm_source\")[0].value = cookieElqCampaigns[0];\n                     document.getElementsByName(\"utm_medium\")[0].value = cookieElqCampaigns[1];\n                     document.getElementsByName(\"utm_campaign\")[0].value = cookieElqCampaigns[2];\n                     document.getElementsByName(\"utm_term\")[0].value = cookieElqCampaigns[3];\n                     document.getElementsByName(\"utm_content\")[0].value = cookieElqCampaigns[4];\n                      }catch(err2){}\n                    }\n                }\n        } else {\n                 var forms = document.querySelectorAll(\n                             ['form.eloquaBasic','form.eloquaGated'].join(',')\n                           );\n                 if(forms.length > 0){\n                     try{\n                     document.getElementById(\"utmsource\").value = urlParams.get(\"utm_source\")?urlParams.get(\"utm_source\"):'';\n                     document.getElementById(\"utmmedium\").value = urlParams.get(\"utm_medium\")?urlParams.get(\"utm_medium\"):'';\n                     document.getElementById(\"utmcampaign\").value = urlParams.get(\"utm_campaign\")?urlParams.get(\"utm_campaign\"):'';\n                     document.getElementById(\"utmterm\").value = urlParams.get(\"utm_term\")?urlParams.get(\"utm_term\"):'';\n                     if(!document.getElementById(\"utmcontent\").value.startsWith(\"ab-test-experiment\")){ //don't override for ab-test Adobe-target\n                       document.getElementById(\"utmcontent\").value = urlParams.get(\"utm_content\")?urlParams.get(\"utm_content\"):'';\n                     }\n                     }catch(er1){}\n                 }\n          \n                 var elqforms = document.querySelectorAll(['form.elq-form'].join(','));\n            \n                 if(elqforms.length > 0){\n                     try{\n                     document.getElementsByName(\"utm_source\")[0].value = urlParams.get(\"utm_source\")?urlParams.get(\"utm_source\"):'';\n                     document.getElementsByName(\"utm_medium\")[0].value = urlParams.get(\"utm_medium\")?urlParams.get(\"utm_medium\"):'';\n                     document.getElementsByName(\"utm_campaign\")[0].value = urlParams.get(\"utm_campaign\")?urlParams.get(\"utm_campaign\"):'';\n                     document.getElementsByName(\"utm_term\")[0].value = urlParams.get(\"utm_term\")?urlParams.get(\"utm_term\"):'';\n                     document.getElementsByName(\"utm_content\")[0].value = urlParams.get(\"utm_content\")?urlParams.get(\"utm_content\"):'';\n                     }catch(er2){ //console.log(\"err \" + er2.message);\n                     }\n                 }\n        }\n      }\nupdateCampaignCookie();\t  \n</script>");